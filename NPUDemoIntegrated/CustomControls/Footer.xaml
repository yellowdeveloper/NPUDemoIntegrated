<UserControl x:Class="NPUDemoIntegrated.CustomControls.Footer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPUDemoIntegrated.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="1600">
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="White" BorderThickness="0,0,1,0">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0">
                    <TextBlock Text="CORE" Foreground="Red" Margin="10,5,0,0" FontSize="20" FontFamily="\Fonts\GmarketSansTTFBold.ttf #G마켓 산스 TTF Bold"/>
                </Viewbox>
                <Viewbox Grid.Column="1">
                    <TextBlock Text="ARM Cortex-M55(360Mhz)&#xA;FPU/Vector-engine/JTAG" Foreground="White" Margin="10,0,10,0"/>
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Column="1" BorderBrush="White" BorderThickness="0,0,1,0">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0">
                    <TextBlock Text="NPU" Foreground="Red" Margin="10,5,0,0" FontSize="20" FontFamily="\Fonts\GmarketSansTTFBold.ttf #G마켓 산스 TTF Bold"/>
                </Viewbox>
                <Viewbox Grid.Column="1">
                    <TextBlock Text="256MACs(480Mhz) 0.24TOPS&#xA;CNN, RNN, LSTM  Int8/Int16" Foreground="White" Margin="10,0,10,0"/>
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Column="2" BorderBrush="White" BorderThickness="0,0,1,0">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0">
                    <TextBlock Text="MEM" Foreground="Red" Margin="10,5,0,0" FontSize="20" FontFamily="\Fonts\GmarketSansTTFBold.ttf #G마켓 산스 TTF Bold"/>
                </Viewbox>
                <Viewbox Grid.Column="1">
                    <TextBlock Text="Internal SRAM 6MB&#xA;(ITCM/DTCM 256KB/256KB)&#xA;External Octal-SPI&#xA;(for PSRAM / Nor Flash)" Foreground="White" Margin="10,0,10,0"/>
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Column="3" BorderBrush="White" BorderThickness="0,0,1,0">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0">
                    <TextBlock Text="PERI" Foreground="Red" Margin="10,5,0,0" FontSize="20" FontFamily="\Fonts\GmarketSansTTFBold.ttf #G마켓 산스 TTF Bold"/>
                </Viewbox>
                <Viewbox Grid.Column="1">
                    <TextBlock Text="32-GPIOS, 2-I2C, I2S&#xA;SDIO, SPIM/SPIS, 2-UART&#xA;4-DMA, 6-Timer, RTC, WDT" Foreground="White" Margin="10,0,10,0"/>
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Column="4" BorderBrush="White" BorderThickness="0,0,1,0">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0">
                    <TextBlock Text="ETC." Foreground="Red" Margin="10,5,0,0" FontSize="20" FontFamily="\Fonts\GmarketSansTTFBold.ttf #G마켓 산스 TTF Bold"/>
                </Viewbox>
                <Viewbox Grid.Column="1">
                    <!--TextBlock Text="Tech: SMIC 28nm&#xA;OperationVoltage:1.8V/0.9V&#xA;Power: 0.158W" Foreground="White" Margin="10,0,10,0"/-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text = "Power" Foreground="White" Margin="10,0,10,0" FontSize="10"/>
                            <TextBlock Grid.Row="1" Text = "{Binding volt, StringFormat={}{0:F3} W}" Foreground="White" Margin="10,0,10,0" FontSize="10"/>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text = "Ampere" Foreground="White" Margin="10,0,10,0" FontSize="10"/>
                            <TextBlock Grid.Row="1" Text = "{Binding amp, StringFormat={}{0:F3} mA}" Foreground="White" Margin="10,0,10,0" FontSize="10"/>
                        </Grid>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
