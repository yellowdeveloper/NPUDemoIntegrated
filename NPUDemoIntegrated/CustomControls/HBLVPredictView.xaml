<UserControl x:Class="NPUDemoIntegrated.CustomControls.HBLVPredictView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPUDemoIntegrated.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1600">
    <Border Background="#2A0F12" BorderBrush="#FFB18E92" BorderThickness="0,1,0,1">
        <Grid>
            <Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="2.5,0,0,2.5" BorderThickness="1,1,0,1" BorderBrush="#FF6F3C42 " Margin="10,10,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#FF7F5056" BorderThickness="0,0,0,1" Margin="5,5,5,0">
                                <TextBlock Text="· Real - Time Hand Detection" FontSize="36" HorizontalAlignment="Left" FontFamily="{StaticResource FontNanumNeo}"
                                           FontWeight="Heavy"  Foreground="#FFF7EDEE"/>
                            </Border>
                            <Border Grid.Row="1" Background="Black" Margin="5,5,5,5" CornerRadius="2.5">
                                <Grid Background="Transparent" Margin="0,2.5,0,0">
                                    <Viewbox>
                                        <Image Source="{Binding colorBitmap}"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding rtFps, StringFormat=Fps(real-time): {0:F2}}" Foreground="LawnGreen" FontSize="15" HorizontalAlignment="Right" Margin="0,10,10,0" FontFamily="{StaticResource FontNanumNeo}" FontWeight="Heavy"/>
                                    <ToggleButton HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="60" Panel.ZIndex="10"
                                                      Background="Transparent" BorderThickness="0" Style="{StaticResource IRMenuToggle}"
                                                      Foreground="White" FontSize="25" IsChecked="{Binding isModuleConfigOpen, Mode=TwoWay}">
                                    </ToggleButton>
                                    <local:IRModuleConfigPanel Width="300" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="5,5,0,5"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="0,2.5,2.5,0" BorderThickness="1,1,1,1" BorderBrush="#FF6F3C42" Margin="0,10,10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="5,5,5,0" BorderBrush="#FF7F5056" BorderThickness="0,0,0,1">
                                <TextBlock Text="· Hb lv Prediction " FontSize="36" HorizontalAlignment="Left" FontFamily="{StaticResource FontNanumNeo}"
                                           FontWeight="Heavy" Foreground="#FFF7EDEE"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <local:IRConfigPanel_Side_ Grid.Column="1" Width="400" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="5,5,0,5"/>
        </Grid>
    </Border>
</UserControl>

