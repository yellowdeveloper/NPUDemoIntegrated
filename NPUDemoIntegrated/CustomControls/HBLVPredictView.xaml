<UserControl x:Class="NPUDemoIntegrated.CustomControls.HBLVPredictView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPUDemoIntegrated.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1600">
    <Border Background="#120507" BorderBrush="#FF9E7D82" BorderThickness="0,1,0,1">
        <Grid>
            <Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="2.5,0,0,2.5" BorderThickness="1,1,0,1" BorderBrush="#FF4D2E32 " Margin="10,10,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#FF5C3A3E" BorderThickness="0,0,0,1" Margin="5,5,5,0">
                                <TextBlock Text="· Real - Time Video" FontSize="36" HorizontalAlignment="Left" FontFamily="{StaticResource FontNanumNeo}"
                                           FontWeight="Heavy"  Foreground="#FFF7EDEE"/>
                            </Border>
                            <Border Grid.Row="1" Background="Transparent" Margin="5,5,5,5" CornerRadius="2.5">
                                <Grid Background="Transparent" Margin="0,2,0,2">
                                    <Viewbox>
                                        <Grid>
                                            <Image Source="{Binding bitmapShow}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding topMessageLeft}" 
                                                           Foreground="White" 
                                                           FontFamily="{StaticResource FontNanumNeo}"
                                                           FontSize="20" 
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,10,0,10"
                                                           >
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect ShadowDepth="0" Color="Black" BlurRadius="4" Opacity="0.8"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50,0,0,0">
                                                    
                                                    <Border Width="245" Height="60" 
                                                            BorderBrush="#FF7FFF00" 
                                                            BorderThickness="3,3,1.5,0" 
                                                            CornerRadius="10,0,0,0"
                                                            HorizontalAlignment="Right" 
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"
                                                            Opacity="0.7">
                                                        <Border.Effect>
                                                            <DropShadowEffect ShadowDepth="0" Color="White" BlurRadius="4" Opacity="0.8"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border Width="30" Height="60" 
                                                            BorderBrush="#FF7FFF00" 
                                                            BorderThickness="3,3,0,3"
                                                            CornerRadius="10,0,0,10"
                                                            HorizontalAlignment="Right" 
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,252,0"
                                                            Opacity="0.7">
                                                        <Border.Effect>
                                                            <DropShadowEffect ShadowDepth="0" Color="White" BlurRadius="4" Opacity="1"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border Width="40" Height="60" 
                                                            BorderBrush="#FF7FFF00" 
                                                            BorderThickness="3,0,0,3" 
                                                            CornerRadius="0,0,0,10"
                                                            HorizontalAlignment="Right" 
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,215,0"
                                                            Opacity="0.7">
                                                        <Border.Effect>
                                                            <DropShadowEffect ShadowDepth="0" Color="White" BlurRadius="4" Opacity="0.8"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border Width="208" Height="60"
                                                            BorderBrush="#FF7FFF00" 
                                                            BorderThickness="3,0,1.5,3" 
                                                            CornerRadius="0,0,0,10"
                                                            HorizontalAlignment="Right" 
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"
                                                            Opacity="0.7">
                                                        <Border.Effect>
                                                            <DropShadowEffect ShadowDepth="0" Color="White" BlurRadius="4" Opacity="0.8"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="0,2.5,2.5,0" BorderThickness="1,1,1,1" BorderBrush="#FF4D2E32" Margin="0,10,10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="5,5,5,0" BorderBrush="#FF5C3A3E" BorderThickness="0,0,0,1">
                                <TextBlock Text="· Anemia Prediction " FontSize="36" HorizontalAlignment="Left" FontFamily="{StaticResource FontNanumNeo}"
                                           FontWeight="Heavy" Foreground="#FFF7EDEE"/>
                            </Border>
                            <Border Grid.Row="1" Background="Transparent" Margin="5,5,5,5">
                                <Grid>
                                    <Viewbox>
                                        <Border Background="Transparent" Width="4" Height="3">
                                            <Image Source="{Binding bitmapSent}"/>
                                        </Border>
                                    </Viewbox>
                                    <ToggleButton HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Background="Transparent" BorderThickness="0" IsChecked="{Binding measureFlag, Mode=TwoWay}"
                                                  Style="{StaticResource MeasureAnemia}" Foreground="White" FontSize="30"/>
                                    <TextBlock Text="{Binding topMessageRight}" 
                                               Foreground="White" 
                                               FontFamily="{StaticResource FontNanumNeo}"
                                               FontSize="30" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,20,0,0"
                                               >
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="0" Color="Black" BlurRadius="4" Opacity="0.8"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <local:IRConfigPanel_Side_ Grid.Column="1" Width="400" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="5,5,0,5"/>
        </Grid>
    </Border>
</UserControl>

