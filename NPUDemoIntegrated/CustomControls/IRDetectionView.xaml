<UserControl x:Class="NPUDemoIntegrated.CustomControls.IRDetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPUDemoIntegrated.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1600">
    <Border Background="#FF26252B" BorderBrush="AliceBlue" BorderThickness="2">
        <Grid>
            <Grid>
                <Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="0" BorderThickness="0,0,0,0" BorderBrush="White" Margin="10,10,5,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="— Real-Time —" FontSize="36" HorizontalAlignment="Center" FontFamily="{StaticResource FontNanumNeo}"
                                           FontWeight="Heavy" Margin="0,5,0,0" Foreground="White"/>
                                <Border Grid.Row="0" HorizontalAlignment="Right">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="📷--🔗" FontSize="20" Margin="5,5,0,5" Background="Transparent"
                                                Command="{Binding ModuleCommand}" TextBlock.TextAlignment="Center"
                                                Style="{StaticResource ButtonToggle}" Tag="{Binding modColor}"/>

                                        <ToggleButton Grid.Column="1" Content="▶" FontSize="30" Margin="20,0,20,5"
                                                      IsChecked="{Binding IsMeasuring, Mode=TwoWay}"
                                                      Command="{Binding AutoMeasureToggleCommand}" Style="{StaticResource ButtonToggle}"
                                                      CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="Black" Margin="5,5,2.5,5" CornerRadius="2.5">
                                    <Grid>
                                        <Viewbox>
                                            <Image Source="{Binding colorBitmap}"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding rtFps, StringFormat=Fps(real-time): {0:F2}}" Foreground="LawnGreen" FontSize="15" HorizontalAlignment="Right" Margin="0,10,10,0" FontFamily="{StaticResource FontNanumNeo}" FontWeight="Heavy"/>
                                        <local:IRModuleConfigPanel Grid.Column="1" Width="300" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="5,5,0,5"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="0" BorderThickness="0,0,0,0" BorderBrush="White" Margin="5,10,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="— Doksan-NPU —" FontSize="36" HorizontalAlignment="Center" FontFamily="{StaticResource FontPretendard}"
                                           FontWeight="Bold" Margin="0,5,0,0" Foreground="White"/>
                                <Border Grid.Row="1" Background="Black" Margin="2.5,5,5,5" CornerRadius="2.5">
                                    <Grid Background="Transparent">
                                        <Viewbox>
                                            <Image Source="{Binding bitmapShow}"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding fps, StringFormat=Fps(inference): {0:F2}}" Foreground="LawnGreen" FontSize="15" HorizontalAlignment="Right" Margin="0,10,10,0" FontFamily="{StaticResource FontNanumNeo}" FontWeight="Heavy"/>
                                        <TextBlock Text="{Binding pixelMax, StringFormat=MAX_TEMP(face) {0:F2}}" Foreground="White" FontSize="15" HorizontalAlignment="Left" Margin="10,10,00,0" FontFamily="{StaticResource FontNanumNeo}" FontWeight="Heavy"/>
                                        <ToggleButton HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" Height="80"
                                                      Background="Transparent" BorderThickness="0" IsChecked="{Binding isSendAuto, Mode=TwoWay}"
                                                      Style="{StaticResource AutoSendToggle}" Foreground="White">
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <local:IRConfigPanel_Side_ Grid.Column="1" Width="400" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="5,5,0,5"/>
        </Grid>
    </Border>
</UserControl>

