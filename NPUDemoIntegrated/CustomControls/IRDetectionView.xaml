<UserControl x:Class="NPUDemoIntegrated.CustomControls.IRDetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPUDemoIntegrated.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1600">
    <Border>
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1,1,1,1" Margin="10,10,0,0" CornerRadius="5,5,0,0">
                        <TextBlock Grid.Row="0" Text = "IR Module Control" FontSize="26" FontFamily="pack://application:,,,/Fonts/#나눔스퀘어 네오" FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" TextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1,0,1,1" Margin="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Conn" FontSize="30" Margin="20,5,20,5" Background="{Binding modColor}" Foreground="Black"
                                    BorderBrush="Black" Command="{Binding ModuleCommand}" TextBlock.TextAlignment="Center"/>
                            <ToggleButton Grid.Column="1" Content="▶" FontSize="40" Margin="20,5,20,5" Background="Transparent"
                                          Foreground="Black" BorderBrush="Black" IsChecked="{Binding IsMeasuring, Mode=TwoWay}"
                                          Command="{Binding AutoMeasureToggleCommand}"
                                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1,0,1,1" Margin="10,0,0,0">
                        <TextBlock Grid.Row="0" Text = "{Binding sensorTemp, StringFormat=SensorTemp {0} ℃}" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" TextAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1,0,1,1" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text = "Size Of Data (bytes)" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="Black" TextAlignment="Center"/>
                            <TextBox Grid.Row="1" Text = "{Binding irConfig.numOfData}" FontSize="20" Foreground="Black" Margin="20,5,20,5"
                                    TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" BorderBrush="Black" BorderThickness="1,0,1,1" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text = "Resolution" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="Black" TextAlignment="Center"/>
                            <TextBox Grid.Row="1" Text = "{Binding irConfig.resolution}" FontSize="20" Foreground="Black" Margin="20,5,20,5"
                                    TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="5" BorderBrush="Black" BorderThickness="1,0,1,1" Margin="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text = "Min Temp" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="Black" TextAlignment="Center"/>
                                <TextBox Grid.Row="1" Text = "{Binding irConfig.minTemp}" FontSize="20" Foreground="Black" Margin="20,5,20,5"
                                        TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text = "Max Temp" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="Black" TextAlignment="Center"/>
                                <TextBox Grid.Row="1" Text = "{Binding irConfig.maxTemp}" FontSize="20" Foreground="Black" Margin="20,5,20,5"
                                         TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="5" BorderBrush="Black" BorderThickness="1,0,1,1" Margin="10,0,0,0">
                        
                    </Border>
                    <Border Grid.Row="6" BorderBrush="Black" BorderThickness="1,0,1,1" Margin="10,0,0,10" CornerRadius="0,0,5,5">
                        <CheckBox Grid.Row="1" Grid.Column="1" Content = "interpolate" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="Black" IsChecked="{Binding isInterpolate, Mode=TwoWay}"/>
                    </Border>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Margin="10,10,5,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Real-Time" FontSize="36" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Fonts/#나눔스퀘어 네오" FontWeight="Heavy" Margin="0,5,0,0"/>
                                <Border Grid.Row="1" Background="Black" Margin="5,5,5,5">
                                    <Grid>
                                        <Viewbox>
                                            <Image Source="{Binding colorBitmap}"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding rtFps, StringFormat=F2}" Foreground="LawnGreen" FontSize="20" HorizontalAlignment="Right" Margin="0,30,10,0" FontFamily="pack://application:,,,/Fonts/#나눔스퀘어 네오" FontWeight="Heavy"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="5" BorderThickness="1,1,1,1" BorderBrush="Black" Margin="5,10,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Doksan-NPU" FontSize="36" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Fonts/#Pretendard" FontWeight="Bold" Margin="0,5,0,0"/>
                                <Border Grid.Row="1" Background="Black" Margin="5,5,5,5">
                                    <Grid Background="Transparent">
                                        <Viewbox>
                                            <Image Source="{Binding bitmapShow}"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding fps, StringFormat=F2}" Foreground="LawnGreen" FontSize="20" HorizontalAlignment="Right" Margin="0,30,10,0" FontFamily="pack://application:,,,/Fonts/#나눔스퀘어 네오" FontWeight="Heavy"/>
                                        <TextBlock Text="{Binding pixelMax, StringFormat=MAX_TEMP(face) {0:F2}}" Foreground="White" FontSize="15" HorizontalAlignment="Left" Margin="10,10,00,0" FontFamily="pack://application:,,,/Fonts/#나눔스퀘어 네오" FontWeight="Heavy"/>
                                        <ToggleButton HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" Height="80"
                                                      Background="Transparent" BorderThickness="0" IsChecked="{Binding isSendAuto, Mode=TwoWay}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Grid Background="Transparent">
                                                                    <Path x:Name="IconPath" Fill="White" HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="False">
                                                                        <Setter TargetName="IconPath" Property="Data" Value="M 6,0 L 39,20 L 6,40 Z"/>
                                                                        <Setter TargetName="IconPath" Property="Margin" Value="5,0,0,0"/>
                                                                    </Trigger>

                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="IconPath" Property="Data" Value="M 2,0 L 18,0 L 18,35 L 2,35 Z M 22,0 L 38,0 L 38,35 L 22,35 Z"/>
                                                                        <Setter TargetName="IconPath" Property="Margin" Value="0,0,0,0"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            
            <local:IRConfigPanel_Side_ Grid.Column="1" Width="400" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="5,5,0,5"/>
        </Grid>
    </Border>
</UserControl>

