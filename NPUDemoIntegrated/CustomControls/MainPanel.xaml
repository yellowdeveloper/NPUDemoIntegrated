<UserControl x:Class="NPUDemoIntegrated.CustomControls.MainPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPUDemoIntegrated.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1600">
    <Border Background="White">
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <ContentPresenter Grid.Row="0" Content="{Binding currentContext}"/>

                <local:Footer Grid.Row="1" DataContext="{Binding currentContext}"/>
            </Grid>
            
        </Grid>
    </Border>
</UserControl>
