<UserControl x:Class="NPUDemoIntegrated.CustomControls.OBJDetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPUDemoIntegrated.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1600">
    <Border>
        <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Margin="10,10,5,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Real-Time" FontSize="36" HorizontalAlignment="Center" FontFamily="{StaticResource FontNanumNeo}" FontWeight="Heavy" Margin="0,5,0,0"/>
                    <Border Grid.Row="1" Background="Black" Margin="5,5,5,5">
                        <Viewbox>
                            <Border Background="White" Width="4" Height="3">
                                <Image Source="{Binding bitmapShow}"/>
                            </Border>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="5" BorderThickness="1,1,1,1" BorderBrush="Black" Margin="5,10,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Doksan-NPU" FontSize="36" HorizontalAlignment="Center" FontFamily="{StaticResource FontPretendard}" FontWeight="Bold" Margin="0,5,0,0"/>
                    <Border Grid.Row="1" Background="Black" Margin="5,5,5,5">
                        <Grid>
                            <Viewbox>
                                <Border Background="White" Width="4" Height="3">
                                    <Image Source="{Binding bitmapSent}"/>
                                </Border>
                            </Viewbox>
                                <TextBlock Text="{Binding fps, StringFormat=F2}" Foreground="LawnGreen" FontSize="20" HorizontalAlignment="Right" Margin="0,30,10,0" FontFamily="{StaticResource FontNanumNeo}" FontWeight="Heavy"/>
                            <ToggleButton HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" Height="80"
                            Background="Transparent" BorderThickness="0" IsChecked="{Binding is_send_auto, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid Background="Transparent">
                                                        <Path x:Name="IconPath" Fill="Gray" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="IconPath" Property="Data" Value="M 6,0 L 39,20 L 6,40 Z"/>
                                                            <Setter TargetName="IconPath" Property="Margin" Value="5,0,0,0"/>
                                                        </Trigger>

                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="IconPath" Property="Data" Value="M 2,0 L 18,0 L 18,35 L 2,35 Z M 22,0 L 38,0 L 38,35 L 22,35 Z"/>
                                                            <Setter TargetName="IconPath" Property="Margin" Value="0,0,0,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                 Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
            <Button Background="Transparent" Command="{Binding ToggleMenuCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding is_menu_open}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <local:OBJConfigPanel_Side_ Grid.Column="1" Width="400" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="5,5,0,5"/>
        </Grid>
    </Border>
</UserControl>
