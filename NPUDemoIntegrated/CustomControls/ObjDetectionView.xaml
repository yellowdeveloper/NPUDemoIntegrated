<UserControl x:Class="NPUDemoIntegrated.CustomControls.OBJDetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPUDemoIntegrated.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1600">
    <Border>
        <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="5" BorderThickness="1" BorderBrush="Black" Margin="10,10,5,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text=" R e a l  —  T i m e " FontSize="36" HorizontalAlignment="Center" FontFamily="{StaticResource FontNanumNeo}" FontWeight="Heavy" Margin="0,5,0,0"/>
                    <Border Grid.Row="1" Background="Black" Margin="5,5,5,5">
                        <Viewbox>
                            <Border Background="White" Width="4" Height="3">
                                <Image Source="{Binding bitmapShow}"/>
                            </Border>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="5" BorderThickness="1,1,1,1" BorderBrush="Black" Margin="5,10,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text=" D o k s a n  —  N P U " FontSize="36" HorizontalAlignment="Center" FontFamily="{StaticResource FontNanumNeo}" FontWeight="Heavy" Margin="0,5,0,0"/>
                    <Border Grid.Row="1" Background="Black" Margin="5,5,5,5">
                        <Grid>
                            <Viewbox>
                                <Border Background="White" Width="4" Height="3">
                                    <Image Source="{Binding bitmapSent}"/>
                                </Border>
                            </Viewbox>
                                <TextBlock Text="{Binding fps, StringFormat=Fps(inference): {0:F2}}" Foreground="LawnGreen" FontSize="15" HorizontalAlignment="Right" Margin="0,10,10,0" FontFamily="{StaticResource FontNanumNeo}" FontWeight="Heavy"/>
                                <ToggleButton HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" Height="80"
                                              Background="Transparent" BorderThickness="0" IsChecked="{Binding isSendAuto, Mode=TwoWay}"
                                              Style="{StaticResource AutoSendToggle}" Foreground="Gray"/>
                            </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
            <Button Background="Transparent" Command="{Binding ToggleMenuCommand}" Style="{StaticResource DisableMenu}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <local:OBJConfigPanel_Side_ Grid.Column="1" Width="400" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="5,5,0,5"/>
        </Grid>
    </Border>
</UserControl>
