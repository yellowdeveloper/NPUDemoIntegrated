<Window x:Class="NPUDemoIntegrated.Windows.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NPUDemoIntegrated.Windows"
        mc:Ignorable="d"
        Title="ErrorWindow" Height="180" Width="360" WindowStyle="ToolWindow" ResizeMode="CanMinimize">
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="CRITICAL ERROR!&#xA;CLOSE THE PROGRAM!!" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold" Foreground="Red" TextAlignment="Center"/>
            <Button Grid.Row="1" Margin="150,5,150,15" Content="OK" FontSize="20" Click="Button_Click"/>
        </Grid>
    </Border>
</Window>
